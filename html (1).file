<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>Student Registration Form</h2>
    <br>
    <form action="" method="post">
    <label for="">Student's Name</label>
    <br>
    <input type="text"><br>
    <br>
    <label for="">Student's password</label>
    <br>
    <input type="password"> <br>

    
    <label for="">Student's Reg.Number</label>
    <br>
    <input type="number">
    <br>
    <label for="">Student's Email_id</label>
    <br>
    <input type="email">
    <br>
    <label for="">Student's DOB</label>
    <br>
    <input type="date">
    <br>
    <label for="">Student's Address</label>
    <br>
    <textarea name="" id="" rows="5" cols="20"></textarea>
    <br>
    <label for="">Upload Photo</label>
    <br>
    <input type="file">
    <br>
    <label for="">Student's Website</label>
    <br>
    <input type="url"><br>
    <table border="1" cellspacing="0">

        <tr>

<thead>
<th>
    SNO
</th>
<th>
    Qualification
</th>
<th>University</th>
</thead>

        </tr>
        <tr>
            <td>1</td>
            <td>10th</td>
            <td>CBSE</td>
        </tr>
        <tr>
            <td>2</td>
            <td>12th</td>
            <td>CBSE</td>
        </tr>
        <tr>
            <td>3</td>
            <td>B.TECH</td>
            <td>PTU</td>
        </tr>
        <tr>
            <td>4</td>
            <td>M.TECH</td>
            <td>LPU</td>
        </tr>
    </table>
<br>
<fieldset>
    <legend>Gender</legend>
    <label for="">Male</label>
    <input type="radio" name="genderr">
    <label for="">Female</label>
    <input type="radio" name="genderr">
</fieldset>
<br>


<fieldset>
<legend>Skills</legend>

<label for="">HTML</label>
<input type="checkbox" name="skills">
<label for="">CSS</label>
<input type="checkbox" name="skills">
<label for="">JS</label>
<input type="checkbox" name="skills">
<label for="">C++</label>
<input type="checkbox" name="skills">
<label for="">Python</label>
<input type="checkbox" name="skills"><label for="">Others</label>
<input type="checkbox" name="skills">
</fieldset>
<br>
<label for="">Course</label>
<br>
<select name="" id="">
<option value="">CSE</option>
<option value="">CSE(AI/ML))</option>
<option value="">Robotics and AI</option>

</select>
<br>
<label for="">Rate Your Programming</label>
<input type="range" min="0" max="10">
<br>

<button>Submit</button> <input type="reset">
</form>
</body>
</html>